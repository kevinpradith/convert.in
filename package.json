{
  "name": "convert-in",
  "version": "0.3.0",
  "description": "Image and PDF tools that run entirely on your own machine: a browser app that never uploads a file, and a CLI sharing the same core.",
  "license": "MIT",
  "author": "Kevin Praditiansyah <kevinpradithh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinpradith/convert.in.git"
  },
  "bugs": {
    "url": "https://github.com/kevinpradith/convert.in/issues"
  },
  "homepage": "https://github.com/kevinpradith/convert.in#readme",
  "keywords": [
    "pdf",
    "pdf-tools",
    "pdf-encryption",
    "merge-pdf",
    "split-pdf",
    "compress-pdf",
    "redaction",
    "watermark",
    "metadata-removal",
    "aes-256",
    "image-converter",
    "avif",
    "jpeg-xl",
    "webassembly",
    "client-side",
    "no-upload",
    "local-first",
    "offline",
    "privacy",
    "cli"
  ],
  "type": "module",
  "files": [
    "bin/",
    "dist-cli/"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "convert.in": "bin/convert.in.mjs"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "npm run notices && node node_modules/vite/bin/vite.js build && node --import tsx scripts/prerender.mts",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "test": "node --import tsx --test test/*.test.ts",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "cli": "node bin/convert.in.mjs",
    "audit:fixtures": "node --import tsx test/encryption-fixtures.mts",
    "test:browser": "python3 test/browser/suite.py dist fixtures",
    "test:cli": "python3 test/cli-smoke.py",
    "test:fuzz": "python3 test/fuzz-cli.py",
    "notices": "node scripts/notices.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "prepack": "npm run build:cli"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.9.1",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
